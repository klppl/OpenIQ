# Copy this file to `secrets.env` and fill in the values, OR export these as
# environment variables. `secrets.env` is gitignored and auto-loaded at startup.
#
# The Connect IQ store signs browse requests with Garmin's PRIVATE OAuth1
# consumer, which the app derives the user identity from (a bearer token is
# rejected). These credentials are NOT distributed with this project — you must
# supply your own. They live inside the Connect IQ Android app's native library
# `libsr.so` (in the config.arm64_v8a APK split); extract them with:
#
#     strings libsr.so | grep -A1 CIQ_APPSTORE_MOBILE
#
# Required — Connect IQ store consumer (key + secret):
GARMIN_CIQ_CONSUMER_KEY=
GARMIN_CIQ_CONSUMER_SECRET=

# Headless auto-login (server/Docker): set both to sign in automatically on
# startup and hide the login form. Use a dedicated account without MFA. Leave
# blank for the interactive login form.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Optional — override the public login consumer (built-in defaults work):
# GARMIN_LOGIN_CONSUMER_KEY=
# GARMIN_LOGIN_CONSUMER_SECRET=

# Optional — where to cache OAuth tokens (Docker image defaults to /data/tokens.json):
# GARMIN_TOKEN_FILE=
